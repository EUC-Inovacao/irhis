# IRHIS backend configuration
# Copy this file to .env (git-ignored) and fill in real values.
# Never commit .env. If credentials were ever committed, rotate them in the Azure portal.
# Full reference: docs/development.md#environment-variables

# --- Database (required for real data) ---
# Without DATABASE_URL the database is disabled and most endpoints return 500.
DATABASE_URL=mysql+pymysql://user:password@your-server.mysql.database.azure.com:3306/your_database
# Optional CA certificate for MySQL TLS (system trust store is used if unset)
# MYSQL_SSL_CA=/path/to/DigiCertGlobalRootCA.crt.pem

# --- Security ---
# JWT signing key. Required when FLASK_ENV=production.
SECRET_KEY=change-me-to-a-long-random-string

# development (default) or production
FLASK_ENV=development

# Comma-separated origins for browser clients (not needed by the mobile app)
# CORS_ALLOWED_ORIGINS=https://admin.example.com

# --- Development only ---
# Enables two built-in test accounts (IRHIS-D-900001 doctor, IRHIS-900001 patient).
# Ignored when FLASK_ENV=production.
# DEV_AUTH_MODE=mock
# DEV_TEST_PASSWORD=DevPass123

# Port for `python app.py`
# PORT=5001
