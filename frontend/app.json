{
  "expo": {
    "name": "IRHIS",
    "slug": "demoirhisn",
    "version": "1.1.0",
    "runtimeVersion": "1.1.1",
    "updates": {
      "url": "https://u.expo.dev/5f6b9979-1140-45fc-bd2b-1a2bef360758",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    },
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eucinno.irhis",
      "buildNumber": "9",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMotionUsageDescription": "This app uses motion/accelerometer data to improve the experience.",
        "NSCameraUsageDescription": "Camera is used to capture images.",
        "NSPhotoLibraryUsageDescription": "Allows selecting photos from your library.",
        "NSPhotoLibraryAddUsageDescription": "Allows saving images to your library.",
        "NSLocationWhenInUseUsageDescription": "Used to access your location while using the app.",
        "NSMicrophoneUsageDescription": "Microphone is used for audio features.",
        "NSBluetoothAlwaysUsageDescription": "This app uses Bluetooth to connect to Movella DOT sensors for movement analysis.",
        "NSBluetoothPeripheralUsageDescription": "This app uses Bluetooth to connect to Movella DOT sensors for movement analysis.",
        "UIBackgroundModes": [
          "bluetooth-central"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "irhis-api.azurewebsites.net": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSIncludesSubdomains": true,
              "NSExceptionRequiresForwardSecrecy": false,
              "NSExceptionMinimumTLSVersion": "TLSv1.2"
            }
          }
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ],
    "android": {
      "package": "com.eucinno.irhis",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "5f6b9979-1140-45fc-bd2b-1a2bef360758"
      }
    },
    "owner": "euc-inovacao-portugal-lda"
  }
}
